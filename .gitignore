# Python
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Secrets / credentials
.env
*.env

# PubMed backup files
pubmed/pubmed_results_backup_*.csv
pubmed/pubmed_results_backup_*.json
pubmed/search_log_backup_*.csv

# Temporary files
*.tmp
*.temp

# Downloaded PMC full text (research data, not source code).
# Reconstructible from pmc/pmc_oa_inventory.csv plus the manifest's MD5s.
# pmc/fulltext/manifest.csv and failures.csv are deliberately NOT ignored.
pmc/fulltext/xml/
pmc/fulltext/**/*.part

# Parsed article records (derived research data, not source code).
# Regenerable from the raw XML plus pmc/parse_pmc_xml.py; every record carries
# the source MD5, so a rebuild can be proven to match.
pmc/parsed/

# Scratch inventories produced while investigating acquisition failures. Not part
# of the corpus and never committed; retry71.csv is regenerable from the snippet
# in pmc/pmc_xml_retry_2026-09-02_outcome.md.
/retry71.csv

# Retrieval-ready chunks (derived research data, not source code).
# Regenerable deterministically from the parsed corpus plus the frozen M1-M4
# overlays via pmc/build_chunks.py. chunk_stats.json is deliberately NOT ignored:
# it is the committed evidence of the run.
pmc/chunks/chunks.jsonl
