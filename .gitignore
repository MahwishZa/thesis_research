# Python leftovers, virtual environments and test-coverage data
__pycache__/
*.py[cod]
.venv/
venv/
.coverage
htmlcov/

# One folder per dataset in data/ (clinic_patients, published_cases) and the knowledge base (data/knowledge/). Only the tables and
# reports directly in a folder, and the build records in its build/ folder, are committed; originals, downloads and prepared files
# stay on this computer (a dataset's downloads/, raw/ and files/; the knowledge base's texts/ and sources/).
/data/**
!/data/*/
!/data/*/*.csv
!/data/*/*.md
!/data/*/build/
!/data/*/build/*.csv
!/data/.gitkeep

# The archived Version 2 (archive/v2/) keeps the same rules under its own folder.
/archive/v2/data/**
!/archive/v2/data/*/
!/archive/v2/data/*/*.csv
!/archive/v2/data/*/*.md
!/archive/v2/data/*/build/
!/archive/v2/data/*/build/*.csv
archive/v2/results/**/val_*/

# Unfinished runs (a run's folder loses the .partial ending when it finishes)
*.partial/

# Validation runs tune the method; they stay on this computer and are not reported results.
results/**/val_*/

# API keys (also .env.txt and the like, which Windows editors create by mistake)
.env
.env.*
