# Python leftovers, virtual environments and test-coverage data
__pycache__/
*.py[cod]
.venv/
venv/
.coverage
htmlcov/

# One folder per dataset in data/ (data/image/, data/text/ and data/multimodal/). Only the tables and reports directly
# in a dataset's folder are committed; its originals, downloads and prepared files stay on this computer (for the image dataset:
# data/image/raw, data/image/downloads and data/image/dataset; for the text dataset: data/text/sources, data/text/dataset and
# data/text/library).
/data/**
!/data/*/
!/data/*/*.csv
!/data/*/*.md

# Unfinished runs (a run's folder loses the .partial ending when it finishes)
*.partial/

# Validation runs tune the method; they stay on this computer and are not reported results.
results/*/*/val_*/

# API keys (also .env.txt and the like, which Windows editors create by mistake)
.env
.env.*
