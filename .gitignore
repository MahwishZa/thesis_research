# Python leftovers, virtual environments, lint cache and test-coverage data
__pycache__/
*.py[cod]
.ruff_cache/
.venv/
.venv-*/
venv/
.coverage
htmlcov/

# The dataset in data/: the tables, question files, label files and data card are committed; the Kaggle download
# (data/raw/) and the cleaned images (data/processed_images/) stay on the researcher's laptop.
# Zip files are never committed (keep them outside the repository).
/data/raw/
/data/processed_images/
*.zip

# The knowledge corpus: its passages (published text under the sources' licences) and the download cache stay on the laptop;
# data/knowledge_corpus/manifest.csv and corpus_card.json (no text) are committed.
/data/knowledge_corpus/passages.jsonl
/data/knowledge_corpus/cache/
/data/knowledge_corpus/index/
/data/knowledge_corpus/visual/
/data/knowledge_corpus_trial/

# Unfinished runs (a run's folder loses the .partial ending when it finishes), half-written files and run logs
*.partial/
.*.partial
*.log

# The reports of small trials (evaluate.py --answered-only): format checks, never results.
results/**/trial_*.json

# Validation runs tune the method; they stay on this computer and are not reported results (folders <view>_val/).
results/**/*_val/

# API keys (also .env.txt and the like, which Windows editors create by mistake)
.env
.env.*
