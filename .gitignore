# Python leftovers, the virtual environment and the lint cache
__pycache__/
*.py[cod]
.ruff_cache/
.venv/

# The dataset in data/: the tables, question files, label files and data card are committed; the Kaggle download
# (data/raw/) and the cleaned images (data/processed/images/) stay on the researcher's laptop.
# Zip files are never committed (keep them outside the repository).
/data/raw/
/data/processed/images/
*.zip

# The knowledge library: its passages (published text under the sources' licences), the download cache, the indexes and the
# image library stay on the laptop; manifest.csv, corpus_card.json, audit.json and visual_card.json (no text) are committed.
/data/corpus/passages.jsonl
/data/corpus/cache/
/data/corpus/index/
/data/corpus/visual/

# Unfinished runs (a run's folder loses the .partial ending when it finishes), half-written files and run logs
*.partial/
.*.partial
*.log

# The reports of small trials (python -m src.main evaluate --answered-only): format checks, never results.
results/**/trial_*.json

# Validation runs tune the method; they stay on this computer and are not reported results (folders <system>/<view>/<model>_val/).
results/**/*_val/

# API keys (also .env.txt and the like, which Windows editors create by mistake)
.env
.env.*
